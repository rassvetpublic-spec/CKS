{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CKS Knowledge Object",
  "type": "object",
  "required": ["id", "type", "status", "owner", "lifecycle", "relations", "evidence", "history"],
  "properties": {
    "id": {"type": "string", "pattern": "^CKS-[A-Z]+-[0-9]+$"},
    "type": {"enum": ["knowledge", "evidence", "decision", "proposal", "rule", "process", "experiment"]},
    "status": {"enum": ["draft", "review", "active", "superseded", "archived"]},
    "owner": {"type": "string"},
    "lifecycle": {"enum": ["research", "validation", "adoption", "frozen", "archive"]},
    "relations": {"type": "array"},
    "evidence": {"type": "array"},
    "history": {"type": "array"}
  }
}
