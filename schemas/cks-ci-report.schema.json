{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CKS CI Report",
  "type": "object",
  "required": ["schema_version", "mode", "status", "summary", "changed_files", "findings"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "mode": {"enum": ["all", "traceability", "canon", "review-gate"]},
    "status": {"enum": ["PASS", "WARN", "FAIL"]},
    "summary": {
      "type": "object",
      "required": ["fail", "warn", "checked_changed_files"],
      "properties": {
        "fail": {"type": "integer", "minimum": 0},
        "warn": {"type": "integer", "minimum": 0},
        "checked_changed_files": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "changed_files": {"type": "array", "items": {"type": "string"}},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["level", "code", "path", "message"],
        "properties": {
          "level": {"enum": ["WARN", "FAIL"]},
          "code": {"type": "string"},
          "path": {"type": "string"},
          "message": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
